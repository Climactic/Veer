set shell := ["bash", "-cu"]

# Default: run the full dev stack.
default: dev

# Run Vite (:5173) and the Rust backend (:3000) in parallel.
#
# - Default (CSR): open http://localhost:5173. Vite owns the browser.
# - With SSR=1: also launches the Bun SSR sidecar on :13714. Open
#   http://localhost:3000 — Rust is the HTML origin.
#
# Ctrl-C kills everything.
dev:
    #!/usr/bin/env bash
    set -euo pipefail
    [ -d node_modules ] || bun install
    trap 'kill 0' SIGINT SIGTERM EXIT
    bun dev &
    if [ "${SSR:-}" = "1" ]; then
      bun run ssr:dev &
      # The backend runs with ssr_required(true), so a request that arrives
      # before the sidecar is ready fails with "ssr transport: error sending
      # request". Wait for the sidecar's /health to respond before starting it.
      echo "waiting for SSR sidecar on :13714..."
      for _ in {1..100}; do
        if curl -sf -o /dev/null http://127.0.0.1:13714/health 2>/dev/null; then echo "SSR sidecar ready"; break; fi
        sleep 0.1
      done
    fi
    SSR="${SSR:-}" cargo run &
    wait

# Build the production frontend bundle into dist/.
build:
    bun install
    bun run build

# Build the production SSR sidecar bundle into dist/ssr/.
build-ssr:
    bun install
    bun run build:ssr

# Remove generated files and cached deps.
clean:
    rm -rf node_modules dist .vite
    cargo clean
